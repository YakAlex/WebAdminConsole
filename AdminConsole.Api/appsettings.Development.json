{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "DataProtection": {
    "KeyPath": "./keys"
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Certificate": {
          "Path": "./certs/dev-cert.pfx",
          // Throw-away self-signed localhost cert, never leaves this machine — hardcoding
          // the password here is fine (unlike the production cert, which keeps it out of the file).
          "Password": "dev-only-not-secret"
        }
      }
    }
  },

  "Servers": [
    { "Name": "DemoServer1", "IP": "127.0.0.1", "Group": "Demo", "Type": "Windows" },
    { "Name": "DemoServer2", "IP": "127.0.0.2", "Group": "Demo", "Type": "Linux" }
  ]
}
