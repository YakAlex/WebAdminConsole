<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AdminConsole.Domain\AdminConsole.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
    <!-- Version pinned centrally in Directory.Packages.props (CentralPackageTransitivePinningEnabled);
         originally an explicit override here because Hangfire.Core 1.8.24 pulls
         a vulnerable Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr) transitively;
         moved central 2026-08-23 after publish.ps1's staged-merge hash check
         caught AdminConsole.Api resolving a DIFFERENT Newtonsoft.Json version
         than this project/Migration: a plain per-project override can't
         win against a higher transitive floor from another project's own
         graph, only a solution-wide pin can. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Polly" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

  <PropertyGroup>
    <!-- net8.0-windows: Фаза 4 переносить WMI (System.Management), Windows
         Event Log (Eventing.Reader), PerformanceCounter, Win32 Credential
         Manager P/Invoke — усе принципово Windows-only, узгоджено з Api. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
