{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      },
      "Https": {
        "Url": "https://*:5001",
        "Certificate": {
          "Path": "C:\\ProgramData\\AdminConsole\\certs\\adminconsole.pfx"
        }
      }
    }
  },

  "Authorization": {
    "ViewerGroup": "SANTA\\AdminConsole-Admins"
  },

  "ConnectionStrings": {
    "AdminConsoleDb": "Data Source=adminconsole.db;Cache=Shared"
  },

  "Hangfire": {
    "SqliteDbPath": "hangfire.db"
  },

  "DataProtection": {
    "KeyPath": "C:\\ProgramData\\AdminConsole\\keys"
  },

  "Monitoring": {
    "PingIntervalSeconds": 30,
    "OfflinePingIntervalSeconds": 10,
    "ZabbixUrl": "",
    "ZabbixPollIntervalSeconds": 60,
    "RdpPollIntervalSeconds": 120,
    "MinIncidentDurationSeconds": 10,
    "BackupPollIntervalMinutes": 60
  },

  "Servers": [],
  "BackupChecks": []
}
